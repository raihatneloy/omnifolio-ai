# Omnifolio AI — Environment Configuration
# Copy to .env and fill in real values for production.
# Never commit .env to version control.

# ── App ──────────────────────────────────────────────────
APP_NAME=Omnifolio AI
APP_VERSION=0.1.0
ENV=development
SECRET_KEY=change-me-to-a-random-string-in-production-min-32-chars

# ── Database ─────────────────────────────────────────────
# Uses asyncpg for async connections.
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://omnifolio:omnifolio@localhost:5432/omnifolio

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM Provider ─────────────────────────────────────────
# Provider: openrouter | google | openai | anthropic
LLM_PROVIDER=openrouter
# Model ID on the chosen provider.
# Examples:
#   openrouter:     openai/gpt-4o-mini
#                 google/gemini-2.0-flash
#                 minimax/minimax-m2.5-flash
#                 anthropic/claude-sonnet-4
#   openai:        gpt-4o
#   google:        gemini-2.0-flash
#   anthropic:     claude-sonnet-4
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# ── CORS ─────────────────────────────────────────────────
# Comma-separated origins allowed (set via env override, not this file).
CORS_ORIGINS=http://localhost:3001,http://localhost:3000